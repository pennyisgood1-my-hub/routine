    "react-router-dom": "^7.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
